# Copy to .env next to docker-compose.yml, fill in, then: chmod 600 .env
# Read by the container at start-up.

# Required. Generate with:  python3 -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=

# Required. Generate with:
#   docker compose run --rm stockmonitor python docker/hash_password.py
# Keep the single quotes around the hash.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=''

# Required for the /api/portfolio endpoints.
PORTFOLIO_API_KEY=

# Host port the app is published on.
HOST_PORT=5002

# Set both to true when serving over HTTPS behind nginx/Caddy/Traefik.
SESSION_COOKIE_SECURE=false
TRUST_PROXY=false

# Set to false to run only the web app (no price checks, alerts or EOD report).
RUN_SCHEDULER=true
