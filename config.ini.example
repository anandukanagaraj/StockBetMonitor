# Copy to config.ini next to docker-compose.yml and fill in.
# On a shared/E2E server, keep EMAIL/TELEGRAM/PUBLISH off unless this is the
# only scheduler running, or every alert will be sent twice.

[MARKET]
START_TIME=09:15
END_TIME=15:30
REPORT_TIME=15:35
CHECK_INTERVAL_MINUTES=30
# NSE trading holidays (YYYY-MM-DD, comma-separated). Update annually.
HOLIDAYS=2026-01-26,2026-03-03,2026-03-26,2026-03-31,2026-04-03,2026-04-14,2026-05-01,2026-05-28,2026-06-26,2026-09-14,2026-10-02,2026-10-20,2026-11-10,2026-11-24,2026-12-25

[SCHEDULER]
STOCK_GROUP_CODES=SWING
PRICE_FETCH_WORKERS=8

[EMAIL]
ENABLE_EMAIL=NO
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL=
APP_PASSWORD=
TO_EMAIL=

[WHATSAPP]
ENABLE_WHATSAPP=NO
ACCESS_TOKEN=
PHONE_NUMBER_ID=
RECIPIENT=

[TELEGRAM]
ENABLE_TELEGRAM=NO
BOT_TOKEN=
CHAT_ID=

[ALERTS]
ENABLE_STOPLOSS=YES

[OPTIONS]
WHATIF_TRADE_LIMIT=100
STOCK_MOVE_BACKFILL_LIMIT=5
STCG_TAX_RATE=20
BUSINESS_INCOME_TAX_RATE=30

[API]
# Prefer PORTFOLIO_API_KEY in .env.
PORTFOLIO_API_KEY=

[PUBLISH]
ENABLE_AFTER_EOD=NO
# Leave empty in Docker to use /app/public.
PUBLIC_DIR=
