# Copy to /etc/stockmonitor/stockmonitor.env and chmod 600.
# Read by both systemd units (web app and scheduler).

# Market hours in config.ini are IST; this makes datetime.now() return IST.
TZ=Asia/Kolkata

# Where gunicorn listens. Use 127.0.0.1 behind nginx, 0.0.0.0 to expose directly.
APP_BIND_HOST=0.0.0.0
PORT=5002

# Required when APP_BIND_HOST is not localhost. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=

# Generate with:
#   .venv/bin/python -c "from werkzeug.security import generate_password_hash as g; print(g(input('Password: ')))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Required for API access from anything other than localhost.
PORTFOLIO_API_KEY=

# Set to true only when the site is served over HTTPS.
SESSION_COOKIE_SECURE=false
