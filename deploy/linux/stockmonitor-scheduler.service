[Unit]
Description=StockMonitor V3 scheduler (price checks, alerts, EOD report)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=stockmonitor
WorkingDirectory=/opt/stockmonitor
EnvironmentFile=/etc/stockmonitor/stockmonitor.env
ExecStart=/opt/stockmonitor/.venv/bin/python scheduler.py
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
